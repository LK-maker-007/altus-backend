DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://yali_user:yali_password@localhost:5432/yali_db

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-separate-from-django-secret
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=90

SMS_PROVIDER=mock          # twilio | aws_sns | mock (use mock in dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=yali-media
R2_PUBLIC_URL=https://media.yali.app

EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

QR_TOKEN_SECRET=change-me-hmac-secret-for-qr-tokens
QR_TOKEN_LIFETIME_DAYS=7

SENTRY_DSN=

CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
